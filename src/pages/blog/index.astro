---
import Layout from "../../layouts/layout.astro";
import Footer from "../../components/footer.astro";
import Link from "../../components/link.astro";
import { getCollection } from "astro:content";

const blogEntries = (await getCollection("blog"))
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt))
  .map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
const title = "Blog";
const description = "Ryu's blog.";
---

<Layout title={title} description={description}>
  <div class="flex min-h-svh justify-center overflow-hidden">
    <div class="flex max-w-xl flex-col justify-center gap-4 py-2">
      <h1 class="mb-3 text-center text-2xl">
        {title}
      </h1>

      <ul
        class="relative mb-6 flex w-full min-w-0 flex-col justify-center text-left sm:min-w-md"
      >
        {
          blogEntries.map((entry) => (
            <li class="flex flex-col sm:flex-row sm:items-baseline">
              <time
                class="text-sm text-neutral-500 sm:mr-4"
                datetime={entry.props.entry.data.publishedAt}
              >
                {entry.props.entry.data.publishedAt}
              </time>
              <a href={`/blog/${entry.params.slug}`} class="underline">
                {entry.props.entry.data.title}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex justify-center">
        <Link href="/">Home</Link>
      </div>
      <Footer />
    </div>
  </div>
</Layout>
