---
import Layout from "../layouts/layout.astro";
import Footer from "../components/footer.astro";
import Link from "../components/link.astro";
import RyuappLogo from "../components/icons/ryuapp.astro";

const title = "About";
const description =
  "I'm Ryu, a frontend developer. I like developing and open-source projects.";
---

<Layout title={title} description={description}>
  <div class="flex min-h-svh justify-center bg-zinc-900 text-white">
    <div class="flex max-w-lg flex-col items-center justify-center gap-4 py-2">
      <div class="mx-4 text-sm text-neutral-300">
        <div class="my-2">
          <RyuappLogo />
        </div>
        <p>
          I'm <span class="text-brand inline-block" transition:name="ryu"
            >Ryu</span
          >, a <span class="inline-block" transition:name="frontend-developer"
            >frontend developer</span
          >. OSS development is a hobby of mine. Currently, work involves
          writing <span class="text-[#358EF1]">TypeScript</span> for both web frontends
          and backends, and <span class="text-[#DEA584]">Rust</span> to optimize them.
        </p>
        <br />
        <p>Got something to talk about? Please look for me on the internet.</p>
      </div>
      <Link href="/" variant="dark">Home</Link>
      <Footer isDark={true} />
    </div>
  </div>
</Layout>
