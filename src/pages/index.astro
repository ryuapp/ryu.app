---
import Layout from "../layouts/layout.astro";
import Footer from "../components/footer.astro";
import RyuappLogo from "../components/icons/ryuapp.astro";
import Link from "../components/link.astro";
import { siteConfig } from "../config/site.ts";

const description = "Ryu is a frontend developer.";
---

<Layout description={description}>
  <div
    class="flex min-h-svh justify-center overflow-hidden bg-zinc-900 text-white"
  >
    <div class="flex max-w-lg flex-col justify-center gap-4 py-2">
      <div>
        <div class="relative flex h-16 justify-center">
          <div class="draggable cursor-grab touch-none select-none">
            <RyuappLogo />
          </div>
          <span
            data-pull-hint
            class="pointer-events-none absolute top-1/2 left-[calc(50%+2.75rem)] -translate-y-1/2 text-sm whitespace-nowrap text-neutral-400 opacity-0 transition-opacity duration-500"
            aria-hidden="true"
          >
            ← Drag it
          </span>
        </div>
        <div data-bouncy-wall class="flex items-baseline gap-1">
          <h1 class="inline-block text-lg font-bold" transition:name="ryu">
            Ryu
          </h1>
          <span class="text-md text-neutral-400">@ryuapp</span>
        </div>
        <p
          data-bouncy-wall
          class="inline-block text-neutral-400"
          transition:name="frontend-developer"
        >
          Frontend Developer
        </p>
      </div>

      <nav class="grid justify-items-start gap-1">
        {
          siteConfig.mainNav.map((link) => (
            <Link href={link.href} variant="menu">
              {link.title}
            </Link>
          ))
        }
      </nav>
      <Footer isDark={true} />
    </div>
  </div>
</Layout>

<script>
  import { createBouncyDraggable } from "../utils/bouncy-draggable";

  let cleanup: (() => void) | undefined;
  let hintCleanup: (() => void) | undefined;

  document.addEventListener("astro:before-preparation", () => {
    cleanup?.();
    hintCleanup?.();
    cleanup = undefined;
    hintCleanup = undefined;
  });

  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    hintCleanup?.();
    cleanup = createBouncyDraggable(".draggable");

    const draggable = document.querySelector<HTMLElement>(".draggable");
    const hint = document.querySelector<HTMLElement>("[data-pull-hint]");

    if (!draggable || !hint) {
      hintCleanup = undefined;
      return;
    }

    const showHint = (text: string) => {
      hint.textContent = text;
      hint.classList.remove("opacity-0");
      hint.classList.add("opacity-100");
    };

    const hideHint = () => {
      hint.classList.remove("opacity-100");
      hint.classList.add("opacity-0");
    };

    const hintTimer = window.setTimeout(() => {
      showHint("← Drag it");
    }, 10000);

    const handlePointerDown = () => {
      window.clearTimeout(hintTimer);
      showHint("Throw it!");
    };

    const handlePointerRelease = () => {
      hideHint();
    };

    draggable.addEventListener("pointerdown", handlePointerDown);
    draggable.addEventListener("pointerup", handlePointerRelease);
    draggable.addEventListener("pointercancel", handlePointerRelease);

    hintCleanup = () => {
      window.clearTimeout(hintTimer);
      hideHint();
      draggable.removeEventListener("pointerdown", handlePointerDown);
      draggable.removeEventListener("pointerup", handlePointerRelease);
      draggable.removeEventListener("pointercancel", handlePointerRelease);
    };
  });
</script>
