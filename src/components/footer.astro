---
interface Props {
  isDark?: boolean;
  hiddenIcons?: boolean;
}
const { isDark = false, hiddenIcons = false } = Astro.props;
const textColor = isDark ? "text-gray-400" : "text-gray-500";
---

<footer class="mx-auto my-2">
  <div class="mx-auto max-w-sm text-center text-sm" class:list={textColor}>
    <div class="flex justify-center space-x-1.5">
      <a
        data-bouncy-wall
        href="https://github.com/ryuapp"
        class="underline"
        title="GitHub">GitHub</a
      >
      <a
        data-bouncy-wall
        href="/privacy"
        class="underline"
        title="Privacy Policy">Privacy</a
      >
    </div>
    <span data-bouncy-wall class="text-xs">© 2026 Ryu</span>
  </div>
</footer>
