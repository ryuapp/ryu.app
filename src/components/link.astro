---
interface Props {
  href: string;
  variant?: "default" | "dark" | "menu";
}

const cssDefault = "underline";
const cssMenu = "text-center text-lg underline hover:text-brand!";

const { href, variant = "default" } = Astro.props;
const customCss = variant === "default" ? cssDefault : cssMenu;
---

<a
  data-bouncy-wall
  href={href}
  class="bg-transparent px-4 py-2 text-sm"
  class:list={customCss}
>
  <slot />
</a>
