---
import BaseHead from "../components/base-head.astro";
import Footer from "../components/footer.astro";
import Breadcrumbs, { type Breadcrumb } from "../components/breadcrumbs.astro";

type Frontmatter = {
  title: string;
  description?: string;
  publishedAt?: string;
};
type Props = {
  frontmatter: Frontmatter;
  breadcrumbs?: Array<Breadcrumb>;
};

const { frontmatter, breadcrumbs } = Astro.props;
const { title, description } = frontmatter;
const publishedAt = frontmatter?.publishedAt;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="bg-neutral-50 text-neutral-900" ontouchstart="">
    <div id="main-content" class="transition-fade mx-auto max-w-2xl">
      <main class="p-5">
        <Breadcrumbs title={title} items={breadcrumbs} />
        <article id="markup">
          {title && <h1>{title}</h1>}
          {
            publishedAt && (
              <time class="text-xs text-neutral-500" datetime={publishedAt}>
                {publishedAt}
              </time>
            )
          }
          <slot />
        </article>
        <slot name="other-projects" />
      </main>
      <Footer />
    </div>
  </body>
</html>
